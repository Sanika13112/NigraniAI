# Copy to .env (never commit .env). Generate secrets with: ./scripts/gen-secrets.sh

# Database
DB_URL=jdbc:mysql://mysql:3306/shopsmart_db
DB_USERNAME=shopsmart
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Security (required; services refuse to start without them)
JWT_SECRET=                # at least 32 random bytes, identical for all services
INTERNAL_API_KEY=          # at least 24 chars, identical for all services
COOKIE_SECURE=true         # false only for plain-HTTP local development

# First administrator (created once on startup if it doesn't exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=            # at least 12 characters

# Razorpay (backend only). Test keys start rzp_test_, live keys rzp_live_.
# Leave empty to disable online payments (COD still works).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Store policy (defaults: free delivery; prices are GST-inclusive)
SHIPPING_FLAT_FEE=0
SHIPPING_FREE_ABOVE=0
MERCHANT_NAME=ShopSmart

# Only needed if the frontend is served from a different origin than the gateway
SHOPSMART_ALLOWED_ORIGIN=http://localhost:5173
