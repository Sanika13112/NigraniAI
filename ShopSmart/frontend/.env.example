# Where the Vite dev/preview server proxies /api (the Spring Cloud Gateway). Server-side only.
SHOPSMART_GATEWAY_URL=http://localhost:8080

# Optional: absolute API base if the frontend is hosted on a different origin than the gateway.
# Leave unset to use the same-origin /api proxy (recommended).
# VITE_API_BASE_URL=https://shop.example.com/api

# NEVER put payment secrets in VITE_ variables. The Razorpay key id is delivered by the
# backend per checkout session; the key secret and webhook secret live only on the server.
